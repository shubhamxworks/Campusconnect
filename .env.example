PORT=3000

# Use "sample" to run with local demo events, or "mysql" for a MySQL database.
EVENTS_DATA_SOURCE=sample

# Required only when EVENTS_DATA_SOURCE=mysql. Create this database before running npm run db:setup.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=campusconnect
MYSQL_PASSWORD=
MYSQL_DATABASE=campusconnect

# Google OAuth web client. Add http://localhost:3000/api/auth/google/callback
# as an Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Required for local login sessions. Generate a random secret of at least 32 characters.
# Keep it private. Google OAuth credentials are optional.
SESSION_SECRET=

# Optional browser push delivery. Generate a private/public pair locally with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
