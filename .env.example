PORT=3000

# Use "sample" for local demo events, or "postgres" for Supabase/PostgreSQL.
EVENTS_DATA_SOURCE=sample

# Required only when EVENTS_DATA_SOURCE=postgres. Use the Supabase session pooler URL.
DATABASE_URL=

# Google OAuth web client. Add http://localhost:3000/api/auth/google/callback
# as an Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Required for local login sessions with PostgreSQL. Generate a random secret of at least 32 characters.
# Keep it private. Google OAuth credentials are optional.
SESSION_SECRET=

# Optional browser push delivery. Generate a private/public pair locally with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
